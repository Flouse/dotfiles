// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-d": "git::Diff",
      "cmd-k shift-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "cmd-k shift-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" }
      ],
      "cmd-k shift-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" }
      ],
      "cmd-k shift-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "super-alt-r": "editor::FindAllReferences",
      "alt-shift-f": "editor::FormatSelections",
      "ctrl-k ctrl-r": "workspace::CopyRelativePath",
      "super-shift-d": "editor::DiffClipboardWithSelection"
    }
  },
  {
    "bindings": {
      "ctrl-alt-shift-l": "agent::OpenRulesLibrary",
      "alt-e": "git::ExpandCommitEditor",
      "ctrl-alt-<": "zed::OpenDefaultSettings"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "alt-a": "git::GenerateCommitMessage"
    }
  },
  {
    "context": "GitCommit > Editor",
    "bindings": {
      "alt-a": "git::GenerateCommitMessage"
    }
  }
]
